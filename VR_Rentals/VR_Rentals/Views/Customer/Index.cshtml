@model IEnumerable<VR_Rentals.Models.Customer>

@{
    ViewData["Title"] = "Customer List";
}

<h2 class="mb-4">Customer List</h2>

<p>
    <a asp-action="Create" class="btn btn-success mb-3">
        <i class="bi bi-person-plus"></i> Add New Customer
    </a>
</p>

<table class="table table-striped table-hover align-middle">
    <thead class="table-dark">
        <tr>
            <th>@Html.DisplayNameFor(model => model.First().CustomerName)</th>
            <th>@Html.DisplayNameFor(model => model.First().CustomerSurname)</th>
            <th>@Html.DisplayNameFor(model => model.First().Email)</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.CustomerName</td>
                <td>@item.CustomerSurname</td>
                <td>@item.Email</td>
                <td>
                    <div class="btn-group" role="group">
                        <a asp-action="Edit" asp-route-id="@item.CustomerId" class="btn btn-sm btn-warning">Edit</a>
                        <a asp-action="Delete" asp-route-id="@item.CustomerId" class="btn btn-danger btn-sm">Delete</a>
                    </div>
                </td>
            </tr>
        }
    </tbody>
</table>
