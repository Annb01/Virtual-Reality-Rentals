@model VR_Rentals.Models.Customer

<h2>Delete Confirmation</h2>

<p>Are you sure you want to delete this customer?</p>

<div>
    <strong>@Model.CustomerName @Model.CustomerSurname</strong><br />
    Email: @Model.Email
</div>

<form asp-action="Delete" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="CustomerId" />

    <button type="submit" class="btn btn-danger mt-2">Yes, delete</button>
    <a asp-action="Index" class="btn btn-secondary mt-2">Cancel</a>
</form>
